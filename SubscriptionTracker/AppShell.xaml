<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="SubscriptionTracker.AppShell"
       x:Name="Root"
       Shell.FlyoutBehavior="Disabled"
       FlyoutWidth="250"
       Title="Subscription Tracker">

  <!--
    Navigation items are created in AppShell.xaml.cs:
      • Windows — side menu with coloured icons (collapses to a hamburger menu in a narrow window);
      • Android — bottom tab bar with monochrome icons.
  -->

  <!-- Side menu header (Windows) -->
  <Shell.FlyoutHeader>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,22,16,18">
      <Image Source="app_logo.png" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" />
      <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="-2">
        <Label Text="Subscription" FontFamily="PoppinsBold" FontSize="16" />
        <Label Text="Tracker" FontFamily="PoppinsMedium" FontSize="13"
               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
      </VerticalStackLayout>
    </Grid>
  </Shell.FlyoutHeader>

  <!-- One row of the side menu: coloured icon + title -->
  <Shell.ItemTemplate>
    <DataTemplate x:DataType="BaseShellItem">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="10,8" MinimumHeightRequest="50">
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroupList>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal" />
              <VisualState x:Name="Selected">
                <VisualState.Setters>
                  <Setter TargetName="ItemTitle" Property="Label.FontFamily" Value="PoppinsSemiBold" />
                  <Setter TargetName="ItemTitle" Property="Label.TextColor"
                          Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </VisualState.Setters>
              </VisualState>
            </VisualStateGroup>
          </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>
        <Image Source="{Binding FlyoutIcon}" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
        <Label x:Name="ItemTitle" Grid.Column="1" Text="{Binding Title}" FontFamily="PoppinsMedium" FontSize="15"
               VerticalOptions="Center" />
      </Grid>
    </DataTemplate>
  </Shell.ItemTemplate>

  <Shell.FlyoutFooter>
    <Label x:Name="VersionLabel" Style="{StaticResource Muted}" FontSize="12" Padding="22,12,16,18" />
  </Shell.FlyoutFooter>
</Shell>
