<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:SubscriptionTracker.Models"
             x:Class="SubscriptionTracker.Controls.LogoView"
             x:DataType="m:Subscription"
             WidthRequest="40" HeightRequest="40">
  <!-- Service logo; falls back to the category emoji when no logo is available -->
  <Grid>
    <Border IsVisible="{Binding HasLogo}" BackgroundColor="White" StrokeThickness="0"
            StrokeShape="RoundRectangle 10" Padding="5">
      <Image Source="{Binding Logo}" Aspect="AspectFit" />
    </Border>
    <Label Text="{Binding Icon}" IsVisible="{Binding ShowEmoji}" FontSize="22"
           HorizontalOptions="Center" VerticalOptions="Center" />
  </Grid>
</ContentView>
