<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:SubscriptionTracker.Models"
             x:Class="SubscriptionTracker.Controls.LogoView"
             x:DataType="m:Subscription"
             WidthRequest="40" HeightRequest="40">
  <!-- Service logo on a white tile; falls back to the category emoji on a tinted tile -->
  <Grid>
    <Border IsVisible="{Binding HasLogo}" BackgroundColor="White" StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark=Transparent}"
            StrokeShape="RoundRectangle 12" Padding="6">
      <Image Source="{Binding Logo}" Aspect="AspectFit" />
    </Border>
    <Border IsVisible="{Binding ShowEmoji}" BackgroundColor="{Binding CategorySoftColor}" StrokeThickness="0"
            StrokeShape="RoundRectangle 12">
      <Label Text="{Binding Icon}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
    </Border>
  </Grid>
</ContentView>
