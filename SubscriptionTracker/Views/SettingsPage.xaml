<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SubscriptionTracker.ViewModels"
             x:Class="SubscriptionTracker.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">
  <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="600">

      <!-- Appearance -->
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="6">
          <Label Text="Appearance" Style="{StaticResource Header}" />
          <Label Text="Theme" Style="{StaticResource Muted}" />
          <Picker ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" />
        </VerticalStackLayout>
      </Border>

      <!-- Budget and reminders -->
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="6">
          <Label Text="Monthly budget" Style="{StaticResource Header}" />
          <Label Text="Limit in ₴ (leave empty for no limit)" Style="{StaticResource Muted}" />
          <Entry Text="{Binding BudgetText}" Keyboard="Numeric" Placeholder="1000" />

          <Label Text="Reminders" Style="{StaticResource Header}" Margin="0,12,0,0" />
          <Label Text="Remind me before a payment:" Style="{StaticResource Muted}" />
          <Picker ItemsSource="{Binding RemindOptions}" SelectedItem="{Binding RemindOption}" />
          <Label Text="{Binding RemindHint}" Style="{StaticResource Muted}" />

          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <VerticalStackLayout>
              <Label Text="System notifications" Style="{StaticResource Strong}" />
              <Label Text="Get a notification even when the app is closed" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" VerticalOptions="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWindows}">
            <VerticalStackLayout>
              <Label Text="Run in background at Windows startup" Style="{StaticResource Strong}" />
              <Label Text="Needed for on-time reminders when the window is closed" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Switch Grid.Column="1" IsToggled="{Binding StartWithWindows}" VerticalOptions="Center" />
          </Grid>
          <Button Text="Send test notification" Command="{Binding TestNotificationCommand}"
                  Style="{StaticResource SecondaryButton}" IsEnabled="{Binding NotificationsEnabled}" />

          <Button Text="Save settings" Command="{Binding SaveCommand}" Margin="0,10,0,0" />
        </VerticalStackLayout>
      </Border>

      <!-- Currencies -->
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="6">
          <Label Text="Exchange rates" Style="{StaticResource Header}" />
          <Label Text="Prices in other currencies are converted to ₴ for all totals." Style="{StaticResource Muted}" />
          <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Rates}" Margin="0,4">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="vm:RateItem">
                <Label Text="{Binding Text}" Style="{StaticResource Strong}" />
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
          <Label Text="{Binding RatesUpdatedText}" Style="{StaticResource Muted}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Button Text="Update rates" Command="{Binding UpdateRatesCommand}" Style="{StaticResource SecondaryButton}" />
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsUpdatingRates}" IsVisible="{Binding IsUpdatingRates}"
                               Color="{StaticResource Primary}" WidthRequest="24" HeightRequest="24" />
          </Grid>
        </VerticalStackLayout>
      </Border>

      <!-- Data -->
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Label Text="Data" Style="{StaticResource Header}" />
          <Button Text="Add demo subscriptions" Command="{Binding AddDemoCommand}" Style="{StaticResource SecondaryButton}" />
          <Button Text="Delete all subscriptions" Command="{Binding ClearAllCommand}" Style="{StaticResource DangerButton}" />
          <Label Text="SQLite database file:" Style="{StaticResource Muted}" Margin="0,8,0,0" />
          <Label Text="{Binding DbPath}" FontSize="12" LineBreakMode="CharacterWrap" />
        </VerticalStackLayout>
      </Border>

      <Label Text="Subscription Tracker 1.2 • C# / .NET MAUI / SQLite / MVVM" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
