<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SubscriptionTracker.ViewModels"
             xmlns:m="clr-namespace:SubscriptionTracker.Models"
             xmlns:c="clr-namespace:SubscriptionTracker.Controls"
             x:Class="SubscriptionTracker.Views.CalendarPage"
             x:DataType="vm:CalendarViewModel"
             Title="Calendar">
  <ScrollView>
    <!-- PC: month grid on the left, day details and all charges on the right -->
    <c:AdaptiveColumns Padding="{DynamicResource PagePadding}" Spacing="{DynamicResource SectionSpacing}"
                       Breakpoint="860" FirstColumnShare="0.6" MaximumWidthRequest="1180">

      <!-- ============ Month grid ============ -->
      <Border c:AdaptiveColumns.Column="0" Style="{StaticResource Card}" Padding="{DynamicResource CalendarCardPadding}">
        <VerticalStackLayout Spacing="12">
          <!-- Regular: month on the left, buttons on the right -->
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{DynamicResource WideOnly}">
            <Label Text="{Binding MonthTitle}" Style="{StaticResource Header}" FontSize="18" Margin="4,0,0,0" />
            <Button Grid.Column="1" Text="Today" Command="{Binding GoToTodayCommand}" Style="{StaticResource SecondaryButton}"
                    Padding="14,0" HeightRequest="44" MinimumHeightRequest="44" />
            <ImageButton Grid.Column="2" Source="ic_chevron_left.png" Command="{Binding PrevMonthCommand}"
                         Style="{StaticResource IconButton}" SemanticProperties.Description="Previous month" />
            <ImageButton Grid.Column="3" Source="ic_chevron_right.png" Command="{Binding NextMonthCommand}"
                         Style="{StaticResource IconButton}" SemanticProperties.Description="Next month" />
          </Grid>

          <!-- Compact (phone): ‹ month › with "Today" below, so the month name always fits -->
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6"
                IsVisible="{DynamicResource CompactOnly}">
            <ImageButton Source="ic_chevron_left.png" Command="{Binding PrevMonthCommand}"
                         Style="{StaticResource IconButton}" SemanticProperties.Description="Previous month" />
            <Label Grid.Column="1" Text="{Binding MonthTitle}" Style="{StaticResource Header}" FontSize="17"
                   HorizontalTextAlignment="Center" />
            <ImageButton Grid.Column="2" Source="ic_chevron_right.png" Command="{Binding NextMonthCommand}"
                         Style="{StaticResource IconButton}" SemanticProperties.Description="Next month" />
            <Button Grid.Row="1" Grid.Column="1" Text="Today" Command="{Binding GoToTodayCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Center" FontSize="13"
                    Padding="18,0" HeightRequest="34" MinimumHeightRequest="34" CornerRadius="17" />
          </Grid>

          <VerticalStackLayout Spacing="2">
            <Grid ColumnDefinitions="*,*,*,*,*,*,*">
              <Label Text="Mon" Style="{StaticResource WeekDay}" />
              <Label Grid.Column="1" Text="Tue" Style="{StaticResource WeekDay}" />
              <Label Grid.Column="2" Text="Wed" Style="{StaticResource WeekDay}" />
              <Label Grid.Column="3" Text="Thu" Style="{StaticResource WeekDay}" />
              <Label Grid.Column="4" Text="Fri" Style="{StaticResource WeekDay}" />
              <Label Grid.Column="5" Text="Sat" Style="{StaticResource WeekDay}" />
              <Label Grid.Column="6" Text="Sun" Style="{StaticResource WeekDay}" />
            </Grid>
            <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Start" BindableLayout.ItemsSource="{Binding Days}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarDay">
                  <Border FlexLayout.Basis="14.2857%" HeightRequest="{DynamicResource CalendarCellHeight}" StrokeThickness="0"
                          StrokeShape="RoundRectangle 12" BackgroundColor="{Binding Background}" Padding="0">
                    <Border.GestureRecognizers>
                      <TapGestureRecognizer Command="{Binding SelectCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                      <Label Text="{Binding DayText}" HorizontalTextAlignment="Center" FontAutoScalingEnabled="False"
                             TextColor="{Binding Foreground}" FontFamily="{Binding DayFont}" />
                      <!-- Small logos of the subscriptions charged on this day -->
                      <HorizontalStackLayout HorizontalOptions="Center" Spacing="1" HeightRequest="{DynamicResource CalendarIconSize}"
                                             IsVisible="{Binding HasPayments}">
                        <HorizontalStackLayout Spacing="1" BindableLayout.ItemsSource="{Binding Icons}">
                          <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:Subscription">
                              <Grid WidthRequest="{DynamicResource CalendarIconSize}" HeightRequest="{DynamicResource CalendarIconSize}">
                                <Border IsVisible="{Binding HasLogo}" BackgroundColor="White" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 4" Padding="1">
                                  <Image Source="{Binding Logo}" Aspect="AspectFit" />
                                </Border>
                                <Label Text="{Binding Icon}" IsVisible="{Binding ShowEmoji}" FontSize="10" FontAutoScalingEnabled="False"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                              </Grid>
                            </DataTemplate>
                          </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Label Text="{Binding MoreText}" IsVisible="{Binding HasMore}" FontSize="9" FontAutoScalingEnabled="False"
                               TextColor="{Binding Foreground}" VerticalOptions="Center" />
                      </HorizontalStackLayout>
                    </VerticalStackLayout>
                  </Border>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </FlexLayout>
          </VerticalStackLayout>
        </VerticalStackLayout>
      </Border>

      <!-- ============ Selected day ============ -->
      <Border c:AdaptiveColumns.Column="1" Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Image Source="tile_calendar.png" Style="{StaticResource SectionIcon}" />
            <Label Grid.Column="1" Text="{Binding SelectedTitle}" Style="{StaticResource Header}" />
          </Grid>
          <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding SelectedPayments}">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="vm:PaymentItem">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <c:LogoView BindingContext="{Binding Subscription}" WidthRequest="34" HeightRequest="34" />
                  <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Strong}" VerticalOptions="Center" />
                  <Label Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource Strong}" VerticalOptions="Center" />
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        </VerticalStackLayout>
      </Border>

      <!-- ============ All charges this month ============ -->
      <Border c:AdaptiveColumns.Column="1" Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Image Source="tile_clock.png" Style="{StaticResource SectionIcon}" />
            <Label Grid.Column="1" Text="All charges this month" Style="{StaticResource Header}" />
          </Grid>
          <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding MonthPayments}">
            <BindableLayout.EmptyView>
              <Label Text="No charges this month." Style="{StaticResource Muted}" />
            </BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="vm:PaymentItem">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <c:LogoView BindingContext="{Binding Subscription}" WidthRequest="34" HeightRequest="34" />
                  <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="-2">
                    <Label Text="{Binding Title}" Style="{StaticResource Strong}" LineBreakMode="WordWrap" MaxLines="2" />
                    <Label Text="{Binding DateText}" Style="{StaticResource Muted}" FontSize="12" />
                  </VerticalStackLayout>
                  <Label Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource Strong}" VerticalOptions="Center" />
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
          <BoxView Style="{StaticResource Divider}" />
          <Label Text="{Binding MonthTotalText}" Style="{StaticResource Strong}" />
        </VerticalStackLayout>
      </Border>
    </c:AdaptiveColumns>
  </ScrollView>
</ContentPage>
