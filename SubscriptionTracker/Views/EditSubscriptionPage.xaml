<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SubscriptionTracker.ViewModels"
             xmlns:m="clr-namespace:SubscriptionTracker.Models"
             xmlns:c="clr-namespace:SubscriptionTracker.Controls"
             x:Class="SubscriptionTracker.Views.EditSubscriptionPage"
             x:DataType="vm:EditSubscriptionViewModel"
             Title="{Binding PageTitle}">
  <ScrollView>
    <VerticalStackLayout Padding="{OnIdiom Phone='16,4,16,24', Default='28,8,28,32'}" Spacing="16" MaximumWidthRequest="720">

      <!-- ============ Service ============ -->
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <!-- Logo preview -->
            <Grid WidthRequest="64" HeightRequest="64" VerticalOptions="End">
              <Border IsVisible="{Binding HasLogoPreview}" BackgroundColor="White" StrokeThickness="1"
                      Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark=Transparent}"
                      StrokeShape="RoundRectangle 16" Padding="9">
                <Image Source="{Binding LogoPreview}" Aspect="AspectFit" />
              </Border>
              <Border IsVisible="{Binding NoLogoPreview}" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                      BackgroundColor="{AppThemeBinding Light={StaticResource ChipLight}, Dark={StaticResource ChipDark}}">
                <Label Text="{Binding CategoryIcon}" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
            </Grid>
            <VerticalStackLayout Grid.Column="1" Spacing="6">
              <Label Text="Service name" Style="{StaticResource Caption}" />
              <Border Style="{StaticResource Field}">
                <Entry Text="{Binding Name}" Placeholder="e.g. Spotify" />
              </Border>
            </VerticalStackLayout>
          </Grid>

          <Label Text="Website (used for the logo)" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          <Border Style="{StaticResource Field}">
            <Entry Text="{Binding Website}" Placeholder="e.g. spotify.com" Keyboard="Url" />
          </Border>

          <Label Text="Category" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          <Border Style="{StaticResource Field}">
            <Picker ItemsSource="{Binding CategoryList}" SelectedItem="{Binding Category}" />
          </Border>
        </VerticalStackLayout>
      </Border>

      <!-- ============ Price and dates ============ -->
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="{OnIdiom Phone=96, Default=120}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <VerticalStackLayout Spacing="6">
              <Label Text="Price" Style="{StaticResource Caption}" />
              <Border Style="{StaticResource Field}">
                <Entry Text="{Binding PriceText}" Keyboard="Numeric" Placeholder="119" />
              </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="6">
              <Label Text="Currency" Style="{StaticResource Caption}" />
              <Border Style="{StaticResource Field}">
                <Picker ItemsSource="{Binding CurrencyList}" SelectedItem="{Binding Currency}" />
              </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="6">
              <Label Text="Billing period" Style="{StaticResource Caption}" />
              <Border Style="{StaticResource Field}">
                <Picker ItemsSource="{Binding Periods}" SelectedItem="{Binding BillingPeriod}" />
              </Border>
            </VerticalStackLayout>
          </Grid>
          <Label Text="{Binding PriceHint}" Style="{StaticResource Muted}" FontSize="12" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
            <VerticalStackLayout Spacing="6">
              <Label Text="Next payment" Style="{StaticResource Caption}" />
              <Border Style="{StaticResource Field}">
                <DatePicker Date="{Binding NextPaymentDate}" Format="d" HorizontalOptions="Fill" />
              </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="6">
              <Label Text="Start date" Style="{StaticResource Caption}" />
              <Border Style="{StaticResource Field}">
                <DatePicker Date="{Binding StartDate}" Format="d" HorizontalOptions="Fill" />
              </Border>
            </VerticalStackLayout>
          </Grid>

          <Label Text="Notes" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          <Border Style="{StaticResource Field}">
            <Entry Text="{Binding Notes}" Placeholder="e.g. student plan" />
          </Border>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,10,0,0">
            <VerticalStackLayout VerticalOptions="Center">
              <Label Text="Active" Style="{StaticResource Strong}" />
              <Label Text="Turn off to pause it (paused subscriptions are not counted)" Style="{StaticResource Muted}" FontSize="12" />
            </VerticalStackLayout>
            <Switch Grid.Column="1" IsToggled="{Binding IsActive}" VerticalOptions="Center" />
          </Grid>
        </VerticalStackLayout>
      </Border>

      <!-- ============ Actions ============ -->
      <Button Text="Save" Command="{Binding SaveCommand}" />
      <Button Text="Delete subscription" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEdit}"
              Style="{StaticResource DangerButton}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
