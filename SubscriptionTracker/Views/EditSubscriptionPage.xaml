<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SubscriptionTracker.ViewModels"
             xmlns:m="clr-namespace:SubscriptionTracker.Models"
             xmlns:c="clr-namespace:SubscriptionTracker.Controls"
             x:Class="SubscriptionTracker.Views.EditSubscriptionPage"
             x:DataType="vm:EditSubscriptionViewModel"
             Title="{Binding PageTitle}">
  <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="6" MaximumWidthRequest="600">
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="6">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <!-- Logo preview -->
            <Grid WidthRequest="56" HeightRequest="56" VerticalOptions="End">
              <Border IsVisible="{Binding HasLogoPreview}" BackgroundColor="White" StrokeThickness="0"
                      StrokeShape="RoundRectangle 12" Padding="7">
                <Image Source="{Binding LogoPreview}" Aspect="AspectFit" />
              </Border>
              <Label Text="{Binding CategoryIcon}" IsVisible="{Binding NoLogoPreview}" FontSize="30"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
            <VerticalStackLayout Grid.Column="1" Spacing="6">
              <Label Text="Service name" Style="{StaticResource Muted}" />
              <Entry Text="{Binding Name}" Placeholder="e.g. Spotify" />
            </VerticalStackLayout>
          </Grid>

          <Label Text="Website (used for the logo)" Style="{StaticResource Muted}" />
          <Entry Text="{Binding Website}" Placeholder="e.g. spotify.com" Keyboard="Url" />

          <Label Text="Category" Style="{StaticResource Muted}" />
          <Picker ItemsSource="{Binding CategoryList}" SelectedItem="{Binding Category}" />

          <Grid ColumnDefinitions="*,110,*" ColumnSpacing="12">
            <VerticalStackLayout Spacing="6">
              <Label Text="Price" Style="{StaticResource Muted}" />
              <Entry Text="{Binding PriceText}" Keyboard="Numeric" Placeholder="119" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="6">
              <Label Text="Currency" Style="{StaticResource Muted}" />
              <Picker ItemsSource="{Binding CurrencyList}" SelectedItem="{Binding Currency}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="6">
              <Label Text="Billing period" Style="{StaticResource Muted}" />
              <Picker ItemsSource="{Binding Periods}" SelectedItem="{Binding BillingPeriod}" />
            </VerticalStackLayout>
          </Grid>
          <Label Text="{Binding PriceHint}" Style="{StaticResource Muted}" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <VerticalStackLayout Spacing="6">
              <Label Text="Next payment" Style="{StaticResource Muted}" />
              <DatePicker Date="{Binding NextPaymentDate}" Format="d" MinimumWidthRequest="170" HorizontalOptions="Fill" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="6">
              <Label Text="Start date" Style="{StaticResource Muted}" />
              <DatePicker Date="{Binding StartDate}" Format="d" MinimumWidthRequest="170" HorizontalOptions="Fill" />
            </VerticalStackLayout>
          </Grid>

          <Label Text="Notes" Style="{StaticResource Muted}" />
          <Entry Text="{Binding Notes}" Placeholder="e.g. student plan" />

          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <VerticalStackLayout>
              <Label Text="Active" Style="{StaticResource Strong}" />
              <Label Text="Turn off to pause it (paused subscriptions are not counted)" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Switch Grid.Column="1" IsToggled="{Binding IsActive}" VerticalOptions="Center" />
          </Grid>
        </VerticalStackLayout>
      </Border>

      <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,10,0,0" />
      <Button Text="Delete subscription" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEdit}"
              Style="{StaticResource DangerButton}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
