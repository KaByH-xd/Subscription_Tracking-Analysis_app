<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SubscriptionTracker.ViewModels"
             xmlns:m="clr-namespace:SubscriptionTracker.Models"
             xmlns:c="clr-namespace:SubscriptionTracker.Controls"
             x:Class="SubscriptionTracker.Views.SubscriptionsPage"
             x:DataType="vm:SubscriptionsViewModel"
             Title="Subscriptions">

  <Grid RowDefinitions="Auto,*">
    <!-- ============ Search and filters ============ -->
    <VerticalStackLayout x:Name="Toolbar" Spacing="10" Padding="16,4,16,8">
      <Border Style="{StaticResource Field}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
          <Image Source="ic_search.png" WidthRequest="20" HeightRequest="20" Margin="6,0,0,0" VerticalOptions="Center" />
          <Entry Grid.Column="1" Placeholder="Search by name..." Text="{Binding SearchText}" ClearButtonVisibility="WhileEditing" />
        </Grid>
      </Border>

      <!-- Regular: three filters in a row. Compact (phone): category on its own row, the others below
           (arranged in code-behind, so every value is shown in full) -->
      <Grid x:Name="Filters" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
        <Border x:Name="StatusField" Style="{StaticResource Field}">
          <Picker Title="Status" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" />
        </Border>
        <Border x:Name="CategoryField" Grid.Column="1" Style="{StaticResource Field}">
          <Picker Title="Category" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" />
        </Border>
        <Border x:Name="SortField" Grid.Column="2" Style="{StaticResource Field}">
          <Picker Title="Sort by" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortOption}" />
        </Border>
      </Grid>

      <Label Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="4,0,0,0" />
    </VerticalStackLayout>

    <!-- ============ List: 1 column on a phone, 2–3 on a PC (set in code-behind) ============ -->
    <CollectionView x:Name="List" Grid.Row="1" ItemsSource="{Binding Items}"
                    SelectionMode="Single" SelectedItem="{Binding SelectedItem}" Margin="16,0">
      <CollectionView.ItemsLayout>
        <GridItemsLayout x:Name="ListLayout" Orientation="Vertical" Span="1" VerticalItemSpacing="10" HorizontalItemSpacing="12" />
      </CollectionView.ItemsLayout>
      <CollectionView.EmptyView>
        <VerticalStackLayout Spacing="6" Padding="0,48">
          <Image Source="tile_subscriptions.png" WidthRequest="56" HeightRequest="56" />
          <Label Text="No subscriptions found" Style="{StaticResource Strong}" HorizontalTextAlignment="Center" />
          <Label Text="Change the filters or tap “Add” to create one." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="m:Subscription">
          <Border Style="{StaticResource Card}" Padding="14" Opacity="{Binding ItemOpacity}">
            <!-- Name and price on top, the status line uses the full width below: nothing is cut off -->
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
              <c:LogoView Grid.RowSpan="3" WidthRequest="46" HeightRequest="46" VerticalOptions="Start" />

              <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Strong}" FontSize="15"
                     LineBreakMode="WordWrap" MaxLines="2" />
              <Label Grid.Column="2" Text="{Binding PriceText}" Style="{StaticResource Strong}" FontSize="15"
                     HorizontalTextAlignment="End" />

              <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Chip}" Padding="8,1" HorizontalOptions="Start">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                  <Ellipse Fill="{Binding CategoryColor}" WidthRequest="7" HeightRequest="7" VerticalOptions="Center" />
                  <Label Grid.Column="1" Text="{Binding Category}" Style="{StaticResource ChipText}" FontSize="11" />
                </Grid>
              </Border>
              <Label Grid.Row="1" Grid.Column="2" Text="{Binding UahHint}" Style="{StaticResource Muted}" FontSize="12"
                     HorizontalTextAlignment="End" VerticalOptions="Center" />

              <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding StatusText}" Style="{StaticResource Muted}"
                     FontSize="12" LineBreakMode="WordWrap">
                <Label.Triggers>
                  <DataTrigger TargetType="Label" Binding="{Binding IsDueSoon}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource Warning}" />
                  </DataTrigger>
                </Label.Triggers>
              </Label>
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
      <!-- Room for the floating button -->
      <CollectionView.Footer>
        <BoxView HeightRequest="88" Color="Transparent" />
      </CollectionView.Footer>
    </CollectionView>

    <!-- ============ Floating "Add" button ============ -->
    <Button Grid.RowSpan="2" Text="Add" Style="{StaticResource Fab}" Command="{Binding AddCommand}" />
  </Grid>
</ContentPage>
