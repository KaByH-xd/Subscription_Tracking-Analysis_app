<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SubscriptionTracker.ViewModels"
             x:Class="SubscriptionTracker.Views.UpdatePage"
             x:DataType="vm:UpdateViewModel"
             Title="Update">
  <Grid Padding="16">
    <Border Style="{StaticResource Card}" VerticalOptions="Center" HorizontalOptions="Center"
            MaximumWidthRequest="460" Padding="24">
      <VerticalStackLayout Spacing="10">
        <Label Text="⬆️" FontSize="40" HorizontalTextAlignment="Center" />
        <Label Text="{Binding Title}" Style="{StaticResource Header}" HorizontalTextAlignment="Center" />
        <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        <Label Text="{Binding Hint}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />

        <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding IsBusy}" Margin="0,8,0,0" />
        <Label Text="{Binding Status}" HorizontalTextAlignment="Center" />

        <Button Text="Update now" Command="{Binding UpdateNowCommand}" IsEnabled="{Binding IsIdle}" Margin="0,8,0,0" />
        <Button Text="Later" Command="{Binding LaterCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource SecondaryButton}" />
        <Button Text="What's new" Command="{Binding OpenReleaseNotesCommand}" Style="{StaticResource SecondaryButton}" />
      </VerticalStackLayout>
    </Border>
  </Grid>
</ContentPage>
