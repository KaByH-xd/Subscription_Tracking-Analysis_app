<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <!-- Brand -->
  <Color x:Key="Primary">#5B3FE4</Color>
  <Color x:Key="PrimaryDark">#A898FF</Color>        <!-- accent colour on dark backgrounds -->
  <Color x:Key="PrimaryDeep">#3F24C2</Color>
  <Color x:Key="PrimarySoft">#ECE8FF</Color>
  <Color x:Key="SecondaryDark">#2A2452</Color>

  <!-- Surfaces -->
  <Color x:Key="PageLight">#F4F5FA</Color>
  <Color x:Key="PageDark">#0E0F14</Color>
  <Color x:Key="CardLight">#FFFFFF</Color>
  <Color x:Key="CardDark">#191A22</Color>
  <Color x:Key="SidebarLight">#FFFFFF</Color>
  <Color x:Key="SidebarDark">#14151C</Color>
  <Color x:Key="InputLight">#F4F4F9</Color>
  <Color x:Key="InputDark">#23242E</Color>
  <Color x:Key="StrokeLight">#E6E7EF</Color>
  <Color x:Key="StrokeDark">#2A2B37</Color>
  <Color x:Key="ChipLight">#F0F0F6</Color>
  <Color x:Key="ChipDark">#262733</Color>

  <!-- Text -->
  <Color x:Key="TextLight">#17171F</Color>
  <Color x:Key="TextDark">#F2F2F7</Color>
  <Color x:Key="MutedLight">#6E6E82</Color>
  <Color x:Key="MutedDark">#9C9CAE</Color>

  <!-- Status -->
  <Color x:Key="Danger">#E0413F</Color>
  <Color x:Key="DangerSoft">#FDECEC</Color>
  <Color x:Key="DangerSoftDark">#3A1E22</Color>
  <Color x:Key="Success">#1FA463</Color>
  <Color x:Key="Warning">#E58A00</Color>
  <Color x:Key="WarningSoft">#FFF4E0</Color>
  <Color x:Key="WarningSoftDark">#33281A</Color>
  <Color x:Key="White">#FFFFFF</Color>
  <Color x:Key="HeroText">#E4DEFF</Color>

  <!-- Hero gradient used on the dashboard -->
  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#7158FF" Offset="0" />
    <GradientStop Color="#4A2BD6" Offset="0.6" />
    <GradientStop Color="#3A1FB0" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
