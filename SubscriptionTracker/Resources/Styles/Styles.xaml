<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- Typography: Poppins (Google Fonts, OFL) -->

  <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}" />
  </Style>

  <!-- ===================== Text ===================== -->

  <Style TargetType="Label">
    <Setter Property="FontFamily" Value="PoppinsRegular" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="Strong" TargetType="Label">
    <Setter Property="FontFamily" Value="PoppinsSemiBold" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="Muted" TargetType="Label">
    <Setter Property="FontFamily" Value="PoppinsRegular" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Small caption above a value or a form field -->
  <Style x:Key="Caption" TargetType="Label">
    <Setter Property="FontFamily" Value="PoppinsMedium" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Card / section title -->
  <Style x:Key="Header" TargetType="Label">
    <Setter Property="FontFamily" Value="PoppinsSemiBold" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>

  <Style x:Key="BigNumber" TargetType="Label">
    <Setter Property="FontFamily" Value="PoppinsBold" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="FontSize" Value="24" />
  </Style>

  <!-- White text on the gradient hero card -->
  <Style x:Key="HeroNumber" TargetType="Label">
    <Setter Property="FontFamily" Value="PoppinsBold" />
    <Setter Property="TextColor" Value="{StaticResource White}" />
    <Setter Property="FontSize" Value="{OnIdiom Phone=34, Default=40}" />
  </Style>

  <Style x:Key="HeroCaption" TargetType="Label">
    <Setter Property="FontFamily" Value="PoppinsMedium" />
    <Setter Property="TextColor" Value="{StaticResource HeroText}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="WeekDay" TargetType="Label">
    <Setter Property="FontFamily" Value="PoppinsMedium" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalTextAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- ===================== Surfaces ===================== -->

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    <Setter Property="Padding" Value="{OnIdiom Phone=16, Default=20}" />
  </Style>

  <Style x:Key="HeroCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource HeroBrush}" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="StrokeShape" Value="RoundRectangle 22" />
    <Setter Property="Padding" Value="{OnIdiom Phone=20, Default=26}" />
  </Style>

  <!-- Rounded wrapper for Entry / Picker / DatePicker: same look on Windows and Android -->
  <Style x:Key="Field" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InputLight}, Dark={StaticResource InputDark}}" />
    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    <Setter Property="Padding" Value="{OnPlatform Android='10,0', Default='6,2'}" />
    <Setter Property="MinimumHeightRequest" Value="46" />
  </Style>

  <!-- Small pill with text (days left, category, status) -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChipLight}, Dark={StaticResource ChipDark}}" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>

  <Style x:Key="ChipText" TargetType="Label">
    <Setter Property="FontFamily" Value="PoppinsMedium" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
  </Style>

  <!-- Coloured section icon (tile_*.png) -->
  <Style x:Key="SectionIcon" TargetType="Image">
    <Setter Property="WidthRequest" Value="36" />
    <Setter Property="HeightRequest" Value="36" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>

  <Style x:Key="Divider" TargetType="BoxView">
    <Setter Property="HeightRequest" Value="1" />
    <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" />
  </Style>

  <!-- ===================== Buttons ===================== -->

  <!-- Shared hover / press / disabled feedback for all buttons -->
  <Style x:Key="BaseButton" TargetType="Button">
    <Setter Property="FontFamily" Value="PoppinsSemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="MinimumHeightRequest" Value="46" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup Name="CommonStates">
          <VisualState Name="Normal">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="1" />
              <Setter Property="Scale" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState Name="PointerOver">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="0.88" />
            </VisualState.Setters>
          </VisualState>
          <VisualState Name="Pressed">
            <VisualState.Setters>
              <Setter Property="Scale" Value="0.97" />
            </VisualState.Setters>
          </VisualState>
          <VisualState Name="Disabled">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="0.45" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="FontFamily" Value="PoppinsSemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
    <Setter Property="TextColor" Value="{StaticResource White}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="MinimumHeightRequest" Value="46" />
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="FontFamily" Value="PoppinsSemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource SecondaryDark}}" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="MinimumHeightRequest" Value="46" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="FontFamily" Value="PoppinsSemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
    <Setter Property="TextColor" Value="{StaticResource Danger}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="MinimumHeightRequest" Value="46" />
  </Style>

  <!-- White button on the gradient hero card -->
  <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="FontFamily" Value="PoppinsSemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BackgroundColor" Value="{StaticResource White}" />
    <Setter Property="TextColor" Value="{StaticResource PrimaryDeep}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="MinimumHeightRequest" Value="46" />
  </Style>

  <!-- Square icon button (calendar arrows) -->
  <Style x:Key="IconButton" TargetType="ImageButton">
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup Name="CommonStates">
          <VisualState Name="Normal">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="1" />
              <Setter Property="Scale" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState Name="PointerOver">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="0.88" />
            </VisualState.Setters>
          </VisualState>
          <VisualState Name="Pressed">
            <VisualState.Setters>
              <Setter Property="Scale" Value="0.97" />
            </VisualState.Setters>
          </VisualState>
          <VisualState Name="Disabled">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="0.45" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="WidthRequest" Value="44" />
    <Setter Property="HeightRequest" Value="44" />
  </Style>

  <!-- Floating "Add" button -->
  <Style x:Key="Fab" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="FontFamily" Value="PoppinsSemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
    <Setter Property="TextColor" Value="{StaticResource White}" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="HeightRequest" Value="56" />
    <Setter Property="Padding" Value="20,0,24,0" />
    <Setter Property="ImageSource" Value="ic_plus.png" />
    <Setter Property="ContentLayout" Value="Left,8" />
    <Setter Property="HorizontalOptions" Value="End" />
    <Setter Property="VerticalOptions" Value="End" />
    <Setter Property="Margin" Value="0,0,20,20" />
    <Setter Property="Shadow">
      <Shadow Brush="#5B3FE4" Opacity="0.35" Radius="16" Offset="0,6" />
    </Setter>
  </Style>

  <!-- ===================== Inputs (placed inside a Field border) ===================== -->

  <Style TargetType="Entry">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="FontFamily" Value="PoppinsRegular" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    <Setter Property="MinimumHeightRequest" Value="44" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>

  <Style TargetType="Picker">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="FontFamily" Value="PoppinsRegular" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    <Setter Property="MinimumHeightRequest" Value="44" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="FontFamily" Value="PoppinsRegular" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="MinimumHeightRequest" Value="44" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
  </Style>

  <Style TargetType="Switch">
    <Setter Property="OnColor" Value="{StaticResource Primary}" />
  </Style>

  <Style TargetType="ActivityIndicator">
    <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
  </Style>

  <!-- ===================== Navigation ===================== -->

  <Style TargetType="Shell" ApplyToDerivedTypes="True">
    <!-- Flat top bar that blends with the page -->
    <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}" />
    <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="Shell.NavBarHasShadow" Value="False" />
    <!-- Bottom tab bar (Android) -->
    <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    <!-- Side menu (Windows) -->
    <Setter Property="FlyoutBackgroundColor" Value="{AppThemeBinding Light={StaticResource SidebarLight}, Dark={StaticResource SidebarDark}}" />
  </Style>
</ResourceDictionary>
